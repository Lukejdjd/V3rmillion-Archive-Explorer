# Local host port for direct Docker access.
APP_PORT=8000
IFRAMELY_PORT=8061

# Production API/origin hostname used by Caddy on Oracle Cloud.
SITE_DOMAIN=api.example.com

# Uvicorn worker processes (2 is a good start on 2 OCPU Always Free).
WEB_CONCURRENCY=2

# Rate limits (per client IP, per window seconds)
SEARCH_RATE_LIMIT=15
SEARCH_RATE_WINDOW=60
READ_RATE_LIMIT=60
READ_RATE_WINDOW=60
TURNSTILE_SOFT_LIMIT=10
BLOCK_HARD_LIMIT=100
BLOCK_COOLDOWN_SECONDS=300

# Cloudflare Turnstile (leave empty to disable challenges)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_GRACE_SECONDS=600

# Response cache TTLs (seconds)
CACHE_TTL_SEARCH=60
CACHE_TTL_THREAD=120
CACHE_TTL_USER=300
CACHE_TTL_STATIC=3600
CACHE_MAX_ENTRIES=2048

# API request logging
LOG_REQUESTS=1
